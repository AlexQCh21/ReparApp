<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="125dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_modelo_dispositivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HP Pavilion 15"
            android:textColor="@android:color/black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/img_dispositivo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/ticket_icon"
            android:src="@drawable/tipo_dispositivo" />

        <!-- Tengo dos estados: "Disponible" y "Reportado", esto lo usaré en un recycler view, quiero que me des los drawables y si es posible un ícono dinámico de acuerdo al estado -->
        <TextView
            android:id="@+id/tv_estado_dispositivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_estado_reportado"
            android:text="Reportado"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="12sp" />

<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginTop="4dp"-->
<!--            android:ellipsize="marquee"-->
<!--            android:marqueeRepeatLimit="1"-->
<!--            android:scrollHorizontally="true"-->
<!--            android:singleLine="true"-->
<!--            android:text="i7, 16GB RAM, SSD 512GB"-->
<!--            android:textColor="@android:color/darker_gray"-->
<!--            android:textSize="11sp" />-->
    </LinearLayout>
</androidx.cardview.widget.CardView>