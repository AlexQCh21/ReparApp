<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ticketIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_device_text"
            android:contentDescription="Ticket Type Icon"
            app:tint="@android:color/black"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ticket_codigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FALLO ..."
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ticket_fecha_reporte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 Mayo 2025 - 9:14 Am"
                android:textColor="@color/grey"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ticket_ver_detalle"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="@string/detalle"
            android:textColor="@android:color/white"
            android:backgroundTint = "@android:color/holo_red_dark"
            android:textSize="14sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="end"
            app:cornerRadius="5dp"/>
    </LinearLayout>

</androidx.cardview.widget.CardView>