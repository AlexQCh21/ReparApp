<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"

    >


        <ImageView
            android:id="@+id/ticketIcon"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/icon_ticket_prueba"
            android:contentDescription="Ticket Type Icon"
            app:tint="@android:color/black"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ticket_codigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TICKET"
                android:maxLines="1"
                android:textColor="@color/primary_title"
                android:textSize="16sp"

                android:textStyle="bold" />

            <TextView
                android:id="@+id/ticket_fecha_reporte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 Mayo 2025 - 9:14 Am"
                android:textColor="@color/grey"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ticket_ver_detalle"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="Ir"
            android:textColor="@android:color/white"
            android:backgroundTint = "#121212"
            android:textSize="16sp"
            android:paddingHorizontal="10dp"
            android:textAllCaps="false"
            android:minWidth="0dp"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="end"
            app:cornerRadius="5dp"/>


    </LinearLayout>

