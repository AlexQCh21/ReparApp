<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_knowledge_detail_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_knowledge_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:title="Detalle del conocimiento"
        android:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/icon_close2"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <ImageView
        android:id="@+id/image_knowledge"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:scaleType="centerCrop"
        android:src="@drawable/icon_device_prueba" />

    <TextView
        android:id="@+id/title_knowledge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Título del conocimiento"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/device_type_knowledge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tipo de dispositivo"
        android:textSize="16sp"
        android:textColor="#555555"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/publish_date_knowledge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fecha de publicación"
        android:textSize="14sp"
        android:textColor="#777777"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/author_knowledge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escrito por: Nombre del Técnico"
        android:textSize="14sp"
        android:textStyle="italic"
        android:textColor="#666666"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/description_knowledge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción completa del conocimiento"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginBottom="8dp" />

</LinearLayout>

