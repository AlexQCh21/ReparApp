<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:elevation="5dp"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:id="@+id/txtPregunta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Seguro que quieres cambiar el estado del ticket?"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="@color/primary_title"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            >
            <TextView
                android:id="@+id/tvEstadoActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ESPERA"
                android:textStyle="bold"
                android:textAlignment="textEnd"
                android:textSize="18sp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" a "
                android:textSize="18sp"
                android:layout_gravity="center"
                android:paddingBottom="24dp" />
            <TextView
                android:id="@+id/tvEstadoCambio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="INICIADO"
                android:textStyle="bold"
                android:textAlignment="textStart"
                android:layout_marginStart="10dp"
                android:textSize="18sp"
                android:layout_marginBottom="10dp"
                />


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:backgroundTint="@color/my_custom_red"
                android:background="@drawable/bg_button_popup"
                android:text="Cancelar"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16dp"
                />

            <Button
                android:id="@+id/btnConfirmar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirmar"
                android:background="@drawable/bg_button_popup"
                app:backgroundTint="@color/black"
                android:layout_marginStart="16dp"
                android:textStyle="bold"
                android:textSize="16dp"
                />
        </LinearLayout>
    </LinearLayout>


</androidx.cardview.widget.CardView>


