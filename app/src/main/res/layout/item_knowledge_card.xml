<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintTop_toTopOf="parent">
       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:gravity="start|center"
           android:padding="10dp"
           android:orientation="vertical">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="50dp"
              android:orientation="horizontal">
              <TextView
                  android:id="@+id/textViewTitle"
                  android:layout_width="wrap_content"
                  android:layout_height="match_parent"
                  android:layout_weight="1"
                  android:gravity="start|center"
                  android:text="Pantalla rota de iphone 15"
                  android:textAppearance="?attr/textAppearanceHeadline6"/>

              <ImageView
                  android:id="@+id/imageViewArrow"
                  android:layout_width="50dp"
                  android:layout_height="50dp"
                  android:src="@drawable/ic_arrow_right_png"/>
          </LinearLayout>

           <TextView
               android:id="@+id/textViewDate"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="8dp"
               android:text="18 de Marzo del 2025"
               android:textSize="17sp"
               android:textAppearance="?attr/textAppearanceBody2"
               android:textColor="?android:attr/textColorSecondary" />

           <TextView
               android:id="@+id/textViewDescription"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="16dp"
               android:text="Para el cambio de pantalla de este modelo, debemos consultar con la guía específica ..."
               android:textAppearance="?attr/textAppearanceBody1" />

           <TextView
               android:id="@+id/textViewTechnician"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="16dp"
               android:text="Tec. Quezada Chorres"
               android:textSize="15sp"
               android:textAppearance="?attr/textAppearanceCaption" />
       </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>