<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/auth_flow">

    <!-- ====================================================== -->
    <!-- GRÁFICO ANIDADO 1: FLUJO DE AUTENTICACIÓN              -->
    <!-- Este grupo contiene todas las pantallas de login y    -->
    <!-- registro. La app siempre empieza aquí.                -->
    <!-- ====================================================== -->
    <navigation android:id="@+id/auth_flow"
        app:startDestination="@id/loginFragment">

        <fragment
            android:id="@+id/loginFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.login.LoginFragment"
            android:label="LoginFragment"
            tools:layout="@layout/fragment_login">
            <action
                android:id="@+id/action_loginFragment_to_loginParte2Fragment"
                app:destination="@id/loginParte2Fragment" />
            <action
                android:id="@+id/action_loginFragment_to_signUpFragment"
                app:destination="@id/signUpFragment" />
            <action
                android:id="@+id/action_loginFragment_to_verificacionEmailFragment"
                app:destination="@id/verificacionEmailFragment" />
        </fragment>

        <fragment
            android:id="@+id/loginParte2Fragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.login.LoginParte2Fragment"
            android:label="LoginParte2Fragment"
            tools:layout="@layout/fragment_login_parte2">
            <!-- Acción para saltar al flujo principal y limpiar el historial de login -->
            <action
                android:id="@+id/action_auth_flow_to_main_flow_from_login_p2"
                app:destination="@id/main_flow"
                app:popUpTo="@id/auth_flow"
                app:popUpToInclusive="true" />
        </fragment>


        <fragment
            android:id="@+id/signUpFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.register.SignUpFragment"
            android:label="SignUpFragment"
            tools:layout="@layout/fragment_register">
            <action
                android:id="@+id/action_signUpFragment_to_signUpParte2Fragment"
                app:destination="@id/signUpParte2Fragment" />
        </fragment>

        <fragment
            android:id="@+id/signUpParte2Fragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.register.SignUpParte2Fragment"
            android:label="SignUpParte2Fragment"
            tools:layout="@layout/fragment_register_parte2">
            <argument
                android:name="email"
                app:argType="string" />

            <action
                android:id="@+id/action_signUpParte2Fragment_to_verificacionEmailFragment"
                app:destination="@id/verificacionEmailFragment" />
        </fragment>

        <fragment
            android:id="@+id/verificacionEmailFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.register.VerificationEmailFragment"
            android:label="fragment_verification_email"
            tools:layout="@layout/fragment_verification_email">
            <!-- Acción para saltar al flujo principal y limpiar el historial de registro -->
            <action
                android:id="@+id/action_auth_flow_to_main_flow"
                app:destination="@id/main_flow"
                app:popUpTo="@id/auth_flow"
                app:popUpToInclusive="true" />

        </fragment>

    </navigation>

    <!-- ====================================================== -->
    <!-- GRÁFICO ANIDADO 2: FLUJO PRINCIPAL DE LA APP           -->
    <!-- Este grupo contiene toda la app después de que el     -->
    <!-- usuario ha iniciado sesión.                           -->
    <!-- ====================================================== -->
    <navigation android:id="@+id/main_flow"
        app:startDestination="@id/homeTechnicalFragment"> <!-- Puedes cambiar el startDestination dinámicamente en el código -->

        <argument
            android:name="userRole"
            app:argType="string"
            android:defaultValue="cliente" />

        <fragment
            android:id="@+id/homeTechnicalFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.HomeTechnicalFragment"
            android:label="HomeTechnicalFragment"
            tools:layout="@layout/fragment_home_technical" >
            <action
                android:id="@+id/action_homeTechnicalFragment_to_myTicketsFragment"
                app:destination="@id/myTicketsFragment" />
            <action
                android:id="@+id/action_homeTechnicalFragment_to_profileFragment"
                app:destination="@id/profileFragment" />
            <action
                android:id="@+id/action_homeTechnicalFragment_to_notificationFragment"
                app:destination="@id/notificationFragment" />
            <action
                android:id="@+id/action_homeTechnicalFragment_to_baseConocimientoFragment"
                app:destination="@id/baseConocimientoFragment" />
            <action
                android:id="@+id/action_homeTechnicalFragment_to_inventarioFragment"
                app:destination="@id/inventarioFragment" />
            <action
                android:id="@+id/action_homeTechnicalFragment_to_ticketDetailFragment"
                app:destination="@id/ticketDetailFragment" />
            <action
                android:id="@+id/action_homeTechnicalFragment_to_reportarProblemaTecnicoFragment"
                app:destination="@id/reportarProblemaTecnicoFragment" />
        </fragment>

        <fragment
            android:id="@+id/homeClientFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.HomeClientFragment"
            android:label="HomeClientFragment"
            tools:layout="@layout/fragment_home_user" >
            <action
                android:id="@+id/action_homeClientFragment_to_ubicationFragment"
                app:destination="@id/ubicationFragment" />
            <action
                android:id="@+id/action_homeClientFragment_to_notificationFragment"
                app:destination="@id/notificationFragment" />
            <action
                android:id="@+id/action_homeClientFragment_to_reportarProblemaFragment"
                app:destination="@id/reportarProblemaFragment" />
            <action
                android:id="@+id/action_homeClientFragment_to_profileFragment"
                app:destination="@id/profileFragment" />
            <action
                android:id="@+id/action_homeClientFragment_to_agregarDispositivo"
                app:destination="@id/agregarDispositivo" />
            <action
                android:id="@+id/action_homeClientFragment_to_ticketListUser"
                app:destination="@id/ticketListUser" />
            <action
                android:id="@+id/action_homeClientFragment_to_detailTicket"
                app:destination="@id/detailTicket" />
        </fragment>

        <fragment
            android:id="@+id/inventarioFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.InventarioFragment"
            android:label="fragment_inventario"
            tools:layout="@layout/fragment_inventory" />

        <fragment
            android:id="@+id/reportarProblemaTecnicoFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.ReportProblemaTecnicoFragment"
            android:label="fragment_report_problema_tecnico"
            tools:layout="@layout/fragment_report_problema_tecnico" />

        <fragment
            android:id="@+id/myTicketsFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.MyTicketsFragment"
            android:label="fragment_my_tickets"
            tools:layout="@layout/fragment_my_tickets" >
            <action
                android:id="@+id/action_myTicketsFragment_to_ticketDetailFragment"
                app:destination="@id/ticketDetailFragment" />
        </fragment>

        <fragment
            android:id="@+id/ticketDetailFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.TicketDetailFragment"
            android:label="fragment_ticket_detail"
            tools:layout="@layout/fragment_ticket_detail" >
            <argument
                android:name="ticket"
                app:argType="com.cursokotlin.reparapp.model.Ticket"
                app:nullable="false" />
        </fragment>

        <fragment
            android:id="@+id/profileFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.ProfileFragment"
            android:label="fragment_profile"
            tools:layout="@layout/fragment_profile" >
            <action
                android:id="@+id/action_profileFragment_to_disponibilidadFragment"
                app:destination="@id/disponibilidadFragment" />
        </fragment>

        <fragment
            android:id="@+id/notificationFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.NotificationFragment"
            android:label="fragment_notification"
            tools:layout="@layout/fragment_notification" />

        <fragment
            android:id="@+id/baseConocimientoFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.BaseConocimientoFragment"
            android:label="BaseConocimientoFragment"
            tools:layout="@layout/fragment_knowledge_base" />

        <fragment
            android:id="@+id/disponibilidadFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.DisponibilidadFragment"
            android:label="DisponibilidadFragment"
            tools:layout="@layout/fragment_profile_tech_detail_dialog" />

        <fragment
            android:id="@+id/reportarProblemaFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.ReportarProblemaFragment"
            android:label="ReportarProblemaFragment"
            tools:layout="@layout/fragment_reportar_problema" >
            <action
                android:id="@+id/action_reportarProblemaFragment_to_reportDetailUser"
                app:destination="@id/reportDetailUser" />
        </fragment>

        <fragment
            android:id="@+id/agregarDispositivo"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.DeviceDetailFragment"
            android:label="Agregar Dispositivo"
            tools:layout="@layout/fragment_device_detail" />

        <fragment
            android:id="@+id/ticketListUser"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.TicketListUserFragment"
            android:label="Tickets del Usuario"
            tools:layout="@layout/fragment_ticket_list_user">
            <action
                android:id="@+id/action_ticketListUser_to_detailTicket"
                app:destination="@id/detailTicket" />

        </fragment>

        <fragment
            android:id="@+id/detailTicket"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.DetailTicketFragment"
            android:label="Tickets del Usuario"
            tools:layout="@layout/fragment_detail_ticket">
            <argument
                android:name="ticket"
                app:argType="com.cursokotlin.reparapp.model.Ticket"
                app:nullable="false" />
        </fragment>

        <fragment
            android:id="@+id/reportDetailUser"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.ReportDetailUserFragment"
            android:label="Tickets del Usuario"
            tools:layout="@layout/fragment_report_detail_user">

            <action
                android:id="@+id/action_reportDetailUser_to_reportarProblemaFragment"
                app:destination="@id/reportarProblemaFragment" />
        </fragment>

        <fragment
            android:id="@+id/ubicationFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.UbicationFragment"
            android:label="UbicationFragment"
            tools:layout="@layout/fragment_ubication" >
            <action
                android:id="@+id/action_ubicationFragment_to_ubicationDetailDialogFragment"
                app:destination="@id/ubicationDetailDialogFragment" />
        </fragment>

        <fragment
            android:id="@+id/ubicationDetailDialogFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.UbicationDetailDialogFragment"
            android:label="UbicationDetailDialogFragment"
            tools:layout="@layout/fragment_ubication_detail_dialog" >
            <argument
                android:name="local"
                app:argType="com.cursokotlin.reparapp.model.Local"
                app:nullable="false" />
            <action
                android:id="@+id/action_ubicationDetailDialogFragment_to_mapLocalFragment"
                app:destination="@id/mapLocalFragment" />
        </fragment>

        <fragment
            android:id="@+id/mapLocalFragment"
            android:name="com.cursokotlin.reparapp.views.ui.fragments.MapLocalFragment"
            android:label="MapLocalFragment"
            tools:layout="@layout/fragment_map_local" >
            <argument
                android:name="local"
                app:argType="com.cursokotlin.reparapp.model.Local"
                app:nullable="false" />

        </fragment>

    </navigation>

</navigation>